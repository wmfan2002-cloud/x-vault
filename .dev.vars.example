ADMIN_PASSWORD_HASH=
SESSION_SECRET=
CREDENTIAL_ENC_KEY=

# ── GitHub / Google 登录（本地开发用；线上走 wrangler pages secret put）──
# 两组都留空的话，登录弹窗里的按钮会置灰并提示"站长尚未配置"，站的其余部分照常工作。
# 申请步骤与回调登记见 README「环境变量」一节。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# redirect_uri 必须与提供方后台登记的逐字一致（含协议）。
# 本地调试用 http://localhost:8788；对外用 https://flj.wmxs.cloud。
# 不填则按 Host + X-Forwarded-Proto 推断 —— 能work但线上建议填死。
SITE_ORIGIN=

# 可选：命中的邮箱登录后自动成为 role=admin（逗号分隔）
ADMIN_EMAILS=
# 可选：填了就是白名单，只有名单里的邮箱/域名能登录；都留空 = 任何 GitHub/Google 账号都能登
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=
